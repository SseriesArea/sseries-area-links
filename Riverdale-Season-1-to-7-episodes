    button.classList.add('active');
    var part = season.querySelector('#' + button.dataset.part);
    if (part) {
      part.classList.add('active');
      activateEpisodeQuality(part, selectedQuality);
    }
  });
});
var portalAudioContext = null;
var navigationSoundIndex = 0;
function playPianoSound() {
  try {
    var AudioContext = window.AudioContext || window.webkitAudioContext;
    if (!AudioContext) return;
    portalAudioContext = portalAudioContext || new AudioContext();
    if (portalAudioContext.state === 'suspended') portalAudioContext.resume();
    var notes = [261.63, 293.66, 329.63, 392.00, 440.00, 523.25];
    var note = notes[navigationSoundIndex % notes.length];
    navigationSoundIndex += 1;
    var now = portalAudioContext.currentTime;
    var master = portalAudioContext.createGain();
    master.gain.setValueAtTime(.0001, now);
    master.gain.exponentialRampToValueAtTime(.032, now + .012);
    master.gain.exponentialRampToValueAtTime(.0001, now + 1.05);
    master.connect(portalAudioContext.destination);
    [
      {multiplier: 1, level: .82, type: 'sine'},
      {multiplier: 2, level: .16, type: 'sine'},
      {multiplier: 3, level: .07, type: 'triangle'}
    ].forEach(function(partial) {
      var oscillator = portalAudioContext.createOscillator();
      var partialGain = portalAudioContext.createGain();
      var frequency = note * partial.multiplier;
      oscillator.type = partial.type;
      oscillator.frequency.setValueAtTime(frequency, now);
      oscillator.frequency.exponentialRampToValueAtTime(frequency * .985, now + .9);
      partialGain.gain.value = partial.level;
      oscillator.connect(partialGain);
      partialGain.connect(master);
      oscillator.start(now);
      oscillator.stop(now + 1.1);
    });
  } catch (error) {}
}

function showEpisode(index) {
  var panels = Array.from(document.querySelectorAll('.tab-content'));
  var tabs = Array.from(document.querySelectorAll('.tab-btn'));
  if (!panels.length) return;
  var nextIndex = ((index % panels.length) + panels.length) % panels.length;
  panels.forEach(function(item) { item.classList.remove('active'); });
  tabs.forEach(function(item) { item.classList.remove('active'); });
  if (panels[nextIndex]) {
    panels[nextIndex].classList.add('active');
    var firstEp = panels[nextIndex].querySelector('.part-btn');
    if (firstEp) {
      panels[nextIndex].querySelectorAll('.part-btn,.part-content').forEach(function(x){x.classList.remove('active')});
      firstEp.classList.add('active');
      var part = panels[nextIndex].querySelector('#' + firstEp.dataset.part);
      if (part) {
        part.classList.add('active');
        activateEpisodeQuality(part, selectedQuality);
      }
    }
  }
  if (tabs[nextIndex]) tabs[nextIndex].classList.add('active');
}
