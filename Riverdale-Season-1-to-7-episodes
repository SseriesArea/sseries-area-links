 function tutorialEmbedUrl(rawUrl) {
   try {
     var parsed = new URL(rawUrl, window.location.href);
     var host = parsed.hostname.toLowerCase().replace(/^www\./, '');
     var videoId = '';
     if (host === 'youtu.be') videoId = parsed.pathname.replace(/^\//, '').split('/')[0];
     if (host === 'youtube.com' || host === 'm.youtube.com') {
       if (parsed.pathname === '/watch') videoId = parsed.searchParams.get('v') || '';
       if (parsed.pathname.indexOf('/shorts/') === 0) videoId = parsed.pathname.split('/')[2] || '';
       if (parsed.pathname.indexOf('/embed/') === 0) return parsed.href;
     }
     if (videoId) return 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1&rel=0';
     if (host === 'vimeo.com') {
       var vimeoId = parsed.pathname.match(/\/(\d+)(?:$|\/)/);
       if (vimeoId) return 'https://player.vimeo.com/video/' + vimeoId[1] + '?autoplay=1';
     }
   } catch (error) {}
   return '';
 }
 function closeVideoMedia() {
   var frame = document.getElementById('videoModalFrame');
   var video = document.getElementById('videoModalVideo');
   var status = document.getElementById('videoModalStatus');
   if (frame) { frame.src = ''; frame.hidden = true; }
   if (video) { video.pause(); video.removeAttribute('src'); delete video.dataset.sourceUrl; video.load(); video.hidden = true; }
   if (status) { status.textContent = ''; status.hidden = true; }
 }
 function openVideoPopup(url, title) {
   var modal = document.getElementById('videoModal');
   var frame = document.getElementById('videoModalFrame');
   var video = document.getElementById('videoModalVideo');
   var heading = document.getElementById('videoModalTitle');
   if (!modal || !frame || !video) return;
   closeVideoMedia();
   var embedUrl = tutorialEmbedUrl(url || '');
   if (embedUrl) {
     frame.hidden = false;
     frame.src = embedUrl;
   } else {
     video.hidden = false;
     video.dataset.sourceUrl = url || '';
     video.src = url || '';
     video.load();
     var playAttempt = video.play();
     if (playAttempt && playAttempt.catch) playAttempt.catch(function() {});
   }
   if (heading) heading.textContent = title || 'Video';
   modal.classList.add('active');
   modal.setAttribute('aria-hidden', 'false');
 }
