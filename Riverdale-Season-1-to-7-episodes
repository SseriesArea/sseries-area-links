<script>
var selectedQuality = '';
function activateEpisodeQuality(panel, preferred) {
  if (!panel) return;
  var buttons = Array.from(panel.querySelectorAll('.quality-btn'));
  if (!buttons.length) return;
  var target = preferred ? buttons.find(function(item) {
    return item.textContent.trim().toLowerCase() === preferred;
  }) : null;
  target = target || buttons.find(function(item) { return item.classList.contains('active'); }) || buttons[0];
  panel.querySelectorAll('.quality-btn,.quality-content').forEach(function(item) { item.classList.remove('active'); });
  target.classList.add('active');
  var quality = panel.querySelector('#' + target.dataset.quality);
  if (quality) quality.classList.add('active');
}
document.querySelectorAll('.tab-btn').forEach(function(button) {
  button.addEventListener('click', function() {
    document.querySelectorAll('.tab-btn,.tab-content').forEach(function(item) { item.classList.remove('active'); });
    button.classList.add('active');
    var panel = document.getElementById(button.dataset.tab);
    if (panel) {
      panel.classList.add('active');
      // activate first episode + its quality
      var firstEp = panel.querySelector('.part-btn');
      if (firstEp) {
        panel.querySelectorAll('.part-btn,.part-content').forEach(function(x){x.classList.remove('active')});
        firstEp.classList.add('active');
        var part = panel.querySelector('#' + firstEp.dataset.part);
        if (part) {
          part.classList.add('active');
          activateEpisodeQuality(part, selectedQuality);
        }
      }
    }
  });
});
document.querySelectorAll('.quality-btn').forEach(function(button) {
